{
  "name": "@keel/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env --import @swc-node/register/esm-register --enable-source-maps src/main.ts",
    "build": "tsc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir test",
    "test:db": "prisma migrate deploy && vitest run --dir test-db"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@prisma/client": "6.19.3",
    "@y/websocket-server": "0.1.5",
    "nanoid": "6.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.21.3",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@keel/config": "workspace:*",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.2",
    "@types/node": "24.9.2",
    "@types/ws": "8.18.1",
    "dotenv": "18.0.1",
    "eslint": "10.9.1",
    "prisma": "6.19.3",
    "typescript": "6.0.3",
    "unplugin-swc": "1.6.0",
    "vitest": "4.1.11"
  }
}
